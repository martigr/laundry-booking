# Copy to .env and fill in. Never commit .env; keep it private: chmod 600 .env
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=
ADMIN_USERNAME=admin
# At least 10 characters; only used to create the first admin on an empty database
ADMIN_PASSWORD=
SESSION_COOKIE_SECURE=1
# Number of reverse proxies in front of the app (1 for Caddy/nginx/Traefik on this host)
TRUSTED_PROXIES=1
# Who residents and researchers contact about security problems (shown in /.well-known/security.txt)
SECURITY_CONTACT=mailto:verwaltung@example.ch

# Public address of the app, used for links in mails and the calendar link
BASE_URL=https://waschkueche.example.ch

# Mail via Infomaniak: log in with the full mailbox address; MAIL_FROM must be that
# mailbox or one of its aliases. If port 587 is blocked: SMTP_PORT=465, SMTP_SECURITY=ssl
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=waschkueche@example.ch
SMTP_PASSWORD=
MAIL_FROM=waschkueche@example.ch
MAIL_FROM_NAME=Waschküche
